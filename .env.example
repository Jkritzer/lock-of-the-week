# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# API key from https://the-odds-api.com
ODDS_API_KEY="your-odds-api-key"

# Random secret used to authenticate cron requests (generate with: openssl rand -hex 32)
CRON_SECRET="change-me"
